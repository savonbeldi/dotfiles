# ---------------------------------------------------------------------------
# Autocomplete
#
# Interactive only. Sourced after oh-my-zsh.zsh, which runs compinit and
# prepends $ZSH_CACHE_DIR/completions to $fpath.
#
# Generating a completion script means shelling out to the tool itself, which
# is the expensive part of startup -- `cf complete zsh` alone takes ~430ms.
# So nothing is generated at the prompt: the script is cached as an
# autoloadable _<cmd> file in $ZSH_CACHE_DIR/completions, compinit picks it up
# from $fpath on the next shell, and the cache is only refreshed (in the
# background) when the tool's binary is newer than it. Startup cost is a stat.
#
# This is the same approach the oh-my-zsh kubectl/helm/docker plugins take, so
# only tools *without* an oh-my-zsh plugin belong here. kubectl, helm, docker,
# az and npm already cache themselves via their plugins (cf. oh-my-zsh.zsh) --
# sourcing their completions here would just do that work again, eagerly.
#
# To force a rebuild: rm -f $ZSH_CACHE_DIR/completions/_<cmd>
# ---------------------------------------------------------------------------

# Cache the zsh completion script for $1, as generated by running "$@".
zshrc_cache_completion() {
  local cmd=$1
  (( $+commands[$cmd] )) || return 0

  local cache="$ZSH_CACHE_DIR/completions/_$cmd"

  # A cold cache is not on $fpath yet (compinit already ran), so bind the
  # autoload stub by hand -- it resolves as soon as the file below lands.
  if [[ ! -f $cache ]]; then
    typeset -g -A _comps
    autoload -Uz "_$cmd"
    _comps[$cmd]="_$cmd"
  fi

  # Nothing to do while the cache is newer than the tool that generated it.
  [[ -s $cache && $cache -nt $commands[$cmd] ]] && return 0

  # Refresh off the critical path. TMPPREFIX keeps the temp file in the cache
  # dir so the move is atomic: a failed run can't truncate a good cache.
  zmodload -F zsh/files b:zf_mv
  () {
    local TMPPREFIX="${1:h}/.${1:t}"
    zf_mv -f -- =( "${@:2}" 2>/dev/null ) "$1"
  } "$cache" "$@" &|
}

# Cloudflare cli -- no oh-my-zsh plugin exists for it. Note this `cf` is
# Cloudflare's; zsh-completions ships an unrelated _cf for Cloud Foundry,
# which the cached file below takes over from.
zshrc_cache_completion cf complete zsh

# Thalassa cloud cli
zshrc_cache_completion tcloud completion zsh
